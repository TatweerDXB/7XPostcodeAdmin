# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.env.local

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 7X Security Standard (Section 7.1.3)
# Secrets, certificates, and keys
*.key
*.pfx
*.p12
*.crt
*.cert
*.secrets

# GIS & Spatial Data Files (Section 7.1.3 - no data files in git)
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.gpkg
*.gdb
*.sde
*.sqlite
*.geojson.extract
*.csv.extract

# Agent MCP Configurations (Contains private API keys)
.agents/plugins/**/mcp_config.json
